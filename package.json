{
  "name": "dsh-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "个人工作台：日/周/月计划、统计、报告与 GitLab / 钉钉同步",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "worklog",
    "gitlab",
    "dingtalk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sheliduan/dsh-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/sheliduan/dsh-workbench/issues"
  },
  "homepage": "https://github.com/sheliduan/dsh-workbench#readme",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
